# ABOUTME: Example environment file showing required API keys and credentials
# ABOUTME: Copy this to .env and fill in your actual values

# AI provider (single canonical key; Gemini is the current provider)
AI_KEY=your_ai_provider_key_here

# Google Custom Search
GOOGLE_CSE_API_KEY=your_google_cse_api_key
GOOGLE_CSE_ID=your_custom_search_engine_id

# Google APIs (Gmail, Calendar, Drive)
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Weather
OPENWEATHERMAP_API_KEY=your_openweathermap_key

# News
NEWSAPI_KEY=your_newsapi_key

# Twitter/X (Optional)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Logging Configuration
# Set to "true" to enable file logging to logs/debug.log
ENABLE_FILE_LOGGING=false
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Langfuse Observability (optional but recommended)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# Override host if self-hosting Langfuse, or leave blank for SaaS
LANGFUSE_HOST= # e.g. https://cloud.langfuse.com or https://us.cloud.langfuse.com
# Optional release identifier shown in Langfuse UI
LANGFUSE_RELEASE=local-dev

# Chroma Vector Database Configuration
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_DATABASE=heathcliff
CHROMA_TENANT=your_chroma_tenant_here

# Recent Context Store (defaults shown — override as needed)
# RECENT_CONTEXT_TTL_SECONDS=7200
# RECENT_CONTEXT_MAX_ITEMS=100
# RECENT_CONTEXT_MAX_SNIPPET_CHARS=1200
# RECENT_CONTEXT_MAX_RETURN=5
# RECENT_CONTEXT_STORE_PATH=temp/recent_memory.json

# Mem0 SDK Configuration
MEM0_USER_ID=heathcliff
